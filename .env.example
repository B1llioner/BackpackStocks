# Telegram: токен BotFather и числовой ID владельца (не @username).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Base64 32-байтового Ed25519 signing seed API-ключа Backpack.
# НЕ публичный API key и НЕ ключ кошелька Solana.
BACKPACK_ED25519_SEED_BASE64=

# Заменить учебный адрес своим HTTP(S) proxy; спецсимволы URL-encode.
OUTBOUND_PROXY_URL=http://username:password@proxy.example.com:8080
# Необязательные отдельные маршруты; пустое значение использует общий.
BACKPACK_PROXY_URL=
BACKPACK_WS_PROXY_URL=
JUPITER_PROXY_URL=
JUPITER_REPLAY_PROXY=
SOLANA_PROXY_URL=
RAYDIUM_PROXY_URL=
TELEGRAM_PROXY_URL=

# Необязательный публичный адрес для контекста котировки, без подписи.
JUPITER_QUOTE_WALLET=
# Необязательный developer API key для developer CLI/API.
JUPITER_API_KEY=
# Обычно setup_jupiter.py получает publishable config из публичного JS сайта.
JUPITER_REPLAY_WEBSITE_KEY=

# Только для отдельных реальных сделок, монитору/paper не нужно.
# Base58 64-байтовый keypair или JSON array, не seed-фраза.
SOLANA_WALLET_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Только для live FSM: base64 64-байтового Solana keypair.
SOLANA_KEYPAIR_BASE64=
# Опциональные HTTP API и PostgreSQL.
BACKPACK_STOCKS_API_TOKEN=
POSTGRES_DSN=
